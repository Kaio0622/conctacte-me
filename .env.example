# ============================================================
#  Contact Me — Marketplace de Serviços Locais
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# ── Servidor ────────────────────────────────────────────────
PORT=3000

# Segredo usado para assinar os tokens de sessão e os links de
# aprovação enviados por WhatsApp. TROQUE em produção.
APP_SECRET=troque-este-segredo-em-producao

# URL pública do app. É usada para montar os links de aprovação
# que vão dentro da mensagem de WhatsApp. Em produção coloque o
# domínio real (ex: https://contactme.com.br), senão o link que
# chega no seu celular vai apontar para "localhost" e não abre.
APP_URL=http://localhost:3000

# ── Painel administrativo ───────────────────────────────────
# Usado para entrar em /admin.html e aprovar prestadores.
ADMIN_EMAIL=admin@contactme.local
ADMIN_SENHA=admin123

# ============================================================
#  NOTIFICAÇÃO DE APROVAÇÃO VIA WHATSAPP
# ============================================================

# Número que RECEBE o aviso de novo prestador aguardando aprovação.
# Formato E.164, só dígitos, com código do país. Ex: 5511987654321
ADMIN_WHATSAPP=5511900000000

# Provedor de envio: twilio | meta | link
#   twilio → envia de verdade pela API do Twilio (precisa das chaves abaixo)
#   meta   → envia pela WhatsApp Cloud API oficial da Meta
#   link   → não envia nada; só gera um link wa.me clicável no painel /admin
#            (útil para desenvolvimento, custo zero, nenhuma credencial)
WHATSAPP_PROVIDER=twilio

# ── Twilio (WHATSAPP_PROVIDER=twilio) ───────────────────────
# Pegue em https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio habilitado para WhatsApp. Para testes use o
# sandbox: 14155238886 (e mande "join <palavra>" pro sandbox antes).
TWILIO_WHATSAPP_FROM=14155238886

# ── Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) ────────
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
